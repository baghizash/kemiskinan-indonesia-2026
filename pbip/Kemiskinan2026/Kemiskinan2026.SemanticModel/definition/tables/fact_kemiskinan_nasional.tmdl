table fact_kemiskinan_nasional
	lineageTag: db481cfe-af59-5d9c-a814-0177fe4c1296

	measure 'Rata Rata Persen Miskin' =
			AVERAGE ( fact_kemiskinan_nasional[persen_miskin] )
		formatString: 0.00
		lineageTag: 2abe388f-a518-5893-952f-b1674109460d

	measure 'Persen Miskin Mar 2026' =
			CALCULATE ( [Rata Rata Persen Miskin], dim_periode[periode] = "Mar 2026" )
		formatString: 0.00
		lineageTag: dbb684a2-051c-5da5-ae9e-7d695f9af6fd

	measure 'Persen Miskin Mar 2019' =
