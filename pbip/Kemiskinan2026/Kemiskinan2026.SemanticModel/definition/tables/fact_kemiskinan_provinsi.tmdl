table fact_kemiskinan_provinsi
	lineageTag: f100ca0b-e7e9-5c47-8bda-7bd970d846d7

	measure 'Persen Miskin Provinsi' =
			AVERAGE ( fact_kemiskinan_provinsi[persen_miskin] )
		formatString: 0.00
		lineageTag: ed7c25f2-10ab-51bd-a3f9-b7c3f697102e

	measure 'Jumlah Miskin Provinsi Ribu' =
			SUM ( fact_kemiskinan_provinsi[jumlah_miskin_ribu] )
		formatString: #,##0.00
		lineageTag: 5a956bc2-e096-56b8-8ec4-454bee17c69f

	measure 'Provinsi Di Atas Nasional Mar 2026' =
			CALCULATE ( COUNTROWS ( fact_kemiskinan_provinsi ), dim_periode[periode] = "Mar 2026", FILTER ( fact_kemiskinan_provinsi, fact_kemiskinan_provinsi[persen_miskin] > [Persen Miskin Mar 2026] ) )
		formatString: 0
		lineageTag: bfd7c6dc-616c-5b70-9856-884bccb2bd3f

	column periode_id
		dataType: int64
		formatString: 0
		lineageTag: 943a6fb3-cba3-548d-9acc-44e916425d4f
		summarizeBy: none
		sourceColumn: periode_id

	column periode
		dataType: string
		lineageTag: 622ffa66-8c5e-5a4d-ba87-9ae4705d48b9
		summarizeBy: none
		sourceColumn: periode

	column provinsi
		dataType: string
		lineageTag: 4e6fbfb9-70b8-5e89-b18c-fedb330ae2a6
		summarizeBy: none
		sourceColumn: provinsi

	column persen_miskin
		dataType: double
		formatString: 0.00
		lineageTag: d8fc5b89-dc11-5315-8f4b-ec638a3cd8d3
		summarizeBy: none
		sourceColumn: persen_miskin

	column jumlah_miskin_ribu
		dataType: double
		formatString: #,##0.00
		lineageTag: 5e7cb025-5738-5011-ab2f-62da720764ee
		summarizeBy: none
		sourceColumn: jumlah_miskin_ribu

	column garis_kemiskinan_rp
		dataType: int64
		formatString: #,##0
		lineageTag: 635578be-2e24-5c6b-95c4-0af360a3b700
		summarizeBy: none
		sourceColumn: garis_kemiskinan_rp

	partition fact_kemiskinan_provinsi = m
		mode: import
		source = ```
				let
					Source = Csv.Document(File.Contents(FolderData & "\fact_kemiskinan_provinsi.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					ChangedType = Table.TransformColumnTypes(PromotedHeaders, {{"periode_id", Int64.Type}, {"periode", type text}, {"provinsi", type text}, {"persen_miskin", type number}, {"jumlah_miskin_ribu", type number}, {"garis_kemiskinan_rp", Int64.Type}})
				in
					ChangedType
				```
